diff --git a/osslsigncode.c b/osslsigncode.c
index 40c4860..3e0b76d 100644
--- a/osslsigncode.c
+++ b/osslsigncode.c
@@ -1890,6 +1890,33 @@ static int trusted_cert(X509 *cert, int error) {
     return 0; /* untrusted */
 }
 
+/*
+ * Microsoft Store leaf certificates carry a critical Application Policies
+ * extension (1.3.6.1.4.1.311.21.10) that OpenSSL does not parse, so it
+ * rejects the whole chain. Report whether that extension is the only
+ * unparsed critical one on the certificate, so callers can tolerate it
+ * without tolerating anything else.
+ * [in] cert: X509 certificate
+ * [returns] 1 if nothing else is unparsed, 0 otherwise
+ */
+static int only_ms_app_policies_unhandled(X509 *cert)
+{
+    int i;
+    char buf[128];
+
+    if (!cert)
+        return 0;
+    for (i = 0; i < X509_get_ext_count(cert); i++) {
+        X509_EXTENSION *ex = X509_get_ext(cert, i);
+        if (!X509_EXTENSION_get_critical(ex) || X509_supported_extension(ex))
+            continue;
+        OBJ_obj2txt(buf, sizeof(buf), X509_EXTENSION_get_object(ex), 1);
+        if (strcmp(buf, "1.3.6.1.4.1.311.21.10"))
+            return 0;
+    }
+    return 1;
+}
+
 /*
  * X509_STORE_CTX_verify_cb
  */
@@ -1903,6 +1930,10 @@ static int verify_ca_callback(int ok, X509_STORE_CTX *ctx)
     if (!ok) {
         if (trusted_cert(current_cert, error)) {
             return 1;
+        } else if (error == X509_V_ERR_UNHANDLED_CRITICAL_EXTENSION
+                && only_ms_app_policies_unhandled(current_cert)) {
+            printf("\tWarning: Ignoring unparsed Microsoft Application Policies extension\n");
+            return 1;
         } else if (error == X509_V_ERR_SELF_SIGNED_CERT_IN_CHAIN) {
             printf("\tError: Certificate not found in local repository: %s\n",
                 X509_verify_cert_error_string(error));
@@ -1938,6 +1969,10 @@ static int verify_crl_callback(int ok, X509_STORE_CTX *ctx)
             printf("\tWarning: Ignoring \'%s\' error for CRL validation\n",
                 X509_verify_cert_error_string(error));
             return 1;
+        } else if (error == X509_V_ERR_UNHANDLED_CRITICAL_EXTENSION
+                && only_ms_app_policies_unhandled(current_cert)) {
+            printf("\tWarning: Ignoring unparsed Microsoft Application Policies extension\n");
+            return 1;
         } else if (error == X509_V_ERR_SELF_SIGNED_CERT_IN_CHAIN) {
             printf("\tError: Certificate not found in local repository: %s\n",
                 X509_verify_cert_error_string(error));
