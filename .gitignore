# Flatpak repository
/repo
/test-repo
/flathub

# Build directories
.flatpak-builder
/build
/builddir

# Flatpak bundles
*.flatpak

# Temporary files
*.tmp

# Private key material. repo.gpg is the *public* key and is committed on
# purpose; everything below is the secret half, which must never be.
*.private.gpg
*.asc
*.pem
secring*

# ...except OpenAI's public RPM repository key. The updater pins its full
# fingerprint before trusting it, and uses it only with gpgv.
!com.openai.ChatGPT/openai-rpm-key.asc

# Python bytecode from local updater checks.
__pycache__/
*.pyc
