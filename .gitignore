# Flatpak repository
/repo
/test-repo
/flathub

# Build directories
.flatpak-builder
/build
/builddir

# Flatpak bundles
*.flatpak

# Temporary files
*.tmp

# Private key material. repo.gpg is the *public* key and is committed on
# purpose; everything below is the secret half, which must never be.
*.private.gpg
*.asc
*.pem
secring*

# ...except the Microsoft roots the payload signature is checked against.
# Public, like repo.gpg above, and the one part of that check a substituted
# package cannot reach -- so it has to ship.
!com.openai.ChatGPT/microsoft-roots.pem

# Python bytecode, from running the payload reader locally.
__pycache__/
*.pyc
